:: StoryInit
<<set $questionsLeft to setup.scenario.budget>>
<<set $asked to {}>>
<<set $closed to []>>
<<set $closedReason to {}>>
<<set $followUpUsed to {}>>
<<set $followUpOrder to {}>>
<<set $majorClues to 0>>
<<set $notebook to []>>
<<set $bonus to 0>>
<<set $solved to false>>
<<set $finalAnswer to null>>
<<set $tries to []>>
<<set $lastTryWrong to false>>
<<set $ranking to []>>
<<set $rankingDone to false>>
<<set $current to null>>
<<set $currentQ to null>>
<<set $lastFollowUp to null>>
<<set $lastMain to "Start">>


:: StoryCaption
<<script>>setup.hs.caption(output)<</script>>


:: StoryMenu
<<link `setup.hs.T("menu.map")`>><<run setup.hs.go("Map")>><</link>>
<<link `setup.hs.T("menu.evidence")`>><<run setup.hs.go("Evidence Board")>><</link>>
<<link `setup.hs.T("menu.case_file")`>><<run setup.hs.go("Case File")>><</link>>
<<if setup.scenario.article>><<link `setup.hs.T("menu.newspaper")`>><<run setup.hs.go("Newspaper")>><</link>><</if>>
<<link `setup.hs.T("menu.hear")`>><<run setup.hs.go("HEAR Guide")>><</link>>
<<link `setup.hs.T("menu.rules")`>><<run setup.hs.go("Rules Summary")>><</link>>


