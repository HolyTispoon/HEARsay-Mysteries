:: ScenarioData [script]
/* Generated by build.py from The Commons' Comma – Response Matrix.xlsx and HEARsay game text.xlsx and HEARsay mysteries.docx. Do not edit by hand. */
setup.scenario = {"id": "commons-comma", "title": "The Commons' Comma", "pitch": "The night before the university publicly examines its founding Charter to settle whether a disputed ink mark is a comma, the Charter vanishes from the archive. A first-day work-study assistant in the president's office has until five o'clock to find out who took it, why, and where it is, by interviewing students who were all around the common last night and each have opinions about the controversial renovation of the commons - which the comma examination was supposed to decide.", "budget": 30, "submissions": 3, "asset_dir": "assets", "map": "campus-map.jpg", "logo": "blank-university-logo.png", "masthead": "the-blank-masthead.png", "start_image": "founding-charter.jpg", "news_art": "newspaper-illustration.svg", "article": {"headline": "A Comma Under Scrutiny", "deck": "Tonight five experts will examine the Commons Clause in the University Charter in public. Their reading of one ink mark could decide whether students can veto the $50 million Innovation Hub.", "byline": "By Sofia Alvarez, Staff Writer", "paragraphs": [{"text": "At six o’clock this evening, a panel of five experts will examine the original University Charter in public and report on a single mark of ink in its Commons Clause. If the mark is a comma, every student at Blank University may get a vote on the future of the Commons. If it is a blot, the administration may not need to ask them.", "quote": false}, {"text": "For several centuries the Commons has been the lawn where Blank University students study, sunbathe, and study while sunbathing. A year ago the university announced a $50 million plan to replace it with an “Innovation Hub”: AI-assisted classrooms, a digital library, makerspaces, research offices, labs and an events suite. Administrators have promoted the Hub as a way to improve learning conditions and to put students in the same building as the faculty who teach them.", "quote": false}, {"text": "The students saw it differently and many made their voices heard right away. The primary objection offered by students centered on the loss of the green space at the center of campus. Then things got worse. In a series of articles, The Blank reported on the anonymous donors and found business ties to the contractors hired to do the job as well as to Adrian Vale, Vice President for Campus Development and the senior administrator in charge of the renovation. Vale refused to comment on the allegation of corruption. The Blank also obtained interior design plans for the Hub which reveal that the university plans to use AI-powered facial-recognition scanners at the entrance to every space. The Editorial of this newspaper lambasted the plan, calling the building “Fort Knoxious.”", "quote": false}, {"text": "A broad coalition of student organizations, from the most-politically-enthusiastic preservationists to the usually-conflict-averse a cappella group, has formed a parent organization called The Green Commons Coalition to organize protests and look into legal options in order to stop the renovations. Members wear tree pins and green caps around campus, and several prominent faculty members have been seen wearing the pin. A handful of faculty have even joined the vigil that students dressed as trees keep outside President Tricia Tabula’s house.", "quote": false}, {"text": "The Coalition soon turned from demonstrations to the law, after its members found a clause in the university’s founding Charter now known as the Commons Clause:", "quote": false}, {"text": "“No renovation, alteration, or demolition of the Commons shall proceed without the approval of the University Board of Directors, the President, the Provost, the Faculty Senate, the faculty house masters(,) and students of the University.”", "quote": true}, {"text": "To most readers, and especially to students, the clause looks plain enough. The Coalition has demanded a campus-wide student vote and is confident of the result: in a Blank poll, 94 percent of students said they would vote no.", "quote": false}, {"text": "The administration’s answer rests on the mark in parentheses. In the original Charter the ink after “masters” is smeared, and for generations transcripts have printed the comma in parentheses because no one could be sure it is one. Without the comma, the university argues, “the faculty house masters and students” is a single group, and the house masters’ approval would satisfy the clause.", "quote": false}, {"text": "The argument was received with skepticism and ridicule on campus until people learned of a 2017 federal appeals court case in Maine, in which a missing Oxford comma cost a dairy company $5,000,000. Commas, it turns out, can decide lawsuits. If the university can show that the mark is not a comma, it may be able to defeat the Coalition’s challenge, at least in court.", "quote": false}, {"text": "So the fight over the Commons has transformed into a fight over one little blot of ink. If it is an original comma, students must approve in their own right, and no one can approve on their behalf. If it is ink damage or a later blemish, consulting the house masters may count as consulting the students.", "quote": false}, {"text": "Tonight’s examination is the result. The university agreed to examine the original Charter in public before five experts it appointed and the Coalition approved: Amara Voss, a forensic document examiner; Daniel Wei, a professor of art conservation who specializes in paper and parchment; Lenora Bell, a professor of history and paleographer who specializes in the handwriting of the Charter’s era; Samuel Ortiz, a professor of imaging science who reads damaged documents under ultraviolet and infrared light; and Ruth Halpern, the university’s archivist emeritus. The panel will publish a report giving its considered opinion. Last week The Blank published exclusive photographs of the original Charter, taken out of its exhibit fixture for the first time in decades. That the examination is public at all shows how little many students trust the administration on this project. President Tabula says she welcomes it. In a statement, she said she “believes this is an opportunity to demonstrate the university’s commitment to the truth and the open inquiry that serves it.”", "quote": false}, {"text": "The examination begins at 6 p.m. in the Great Hall.", "quote": false}], "caption": "The smeared mark after “masters” in the Charter’s Commons Clause. For generations, transcripts have printed it in parentheses.", "panel": {"title": "Tonight’s panel", "items": [{"name": "Amara Voss", "text": "Forensic document examiner"}, {"name": "Daniel Wei", "text": "Professor of art conservation"}, {"name": "Lenora Bell", "text": "Professor of history and paleographer"}, {"name": "Samuel Ortiz", "text": "Professor of imaging science"}, {"name": "Ruth Halpern", "text": "University archivist emeritus"}], "after": 11}}, "rank_exact": 1, "rank_near": 0.5, "puzzle": {"mystery": "Who removed the University Charter from the university archive last night, why did they do it, and where is it now?", "solution": "Evan Cho removed the Charter using Mira Shah's credentials. He heard her talking about her suspicions and reviewed the pictures in The Blank, becoming convinced that the document in the picture isn't the original Charter, specifically because it was missing the original crease that is visible in older photographs. She was in the bathroom when he grabbed her card and left the café, ran to the archives and grabbed the Charter. Evan hid the Charter in a poster tube that Jonah Reed forgot at the café, as Jonah tends to be easily distracted when working or studying in the café and often leaves stuff behind him. Evan was surprised and anxious to see that Jonah came back later to pick up the tube, which is why the poster tube, and the Charter, ended up in the theater for the night. Evan had no clue that Mira asked Priya to edit the access log to make it look like it wasn't her who went into the archives at night.", "who_label": "Who removed it?", "where_label": "Where is it now?", "final_answer": {"who": "Evan Cho", "where": "The theater loft"}, "who_options": ["Mira Shah", "Leo Martinez", "Priya Nwosu", "Jonah Reed", "Hana Petrov", "Sofia Alvarez", "Evan Cho", "Nia Williams"], "where_options": ["The theater loft", "The accessibility office", "The student newspaper office", "The Commons café", "The archive reading room", "The business incubator", "The computer lab", "The student government office"]}, "controversy": {"name": "Renovating the Commons", "summary": "The historic Student Commons of Blank University is a lush grassy area that students have used to study, sun-bathe, and study while sunbathing for several centuries now. This may all now change. About a year ago, the university announced a 50 million dollar plan to redevelop the historic Student Commons into an 'Innovation Hub': AI-assisted classrooms, digital library, makers spaces, research offices, lab spaces, a suite for events – all built in a manner that is supposedly eco-friendly and integrates with the current greenery of the commons. The university advertised the plan as an opportunity for the students to improve the learning experiences and conditions while maintaining close connections to the faculty who would be working right in the same building.\n\nMany students oppose this plan and have organized together under an umbrella organization called The Green Commons. The university was moving forward with the plans to renovate despite the resistance but their plan hit a snag when it was published that  the university’s found Charter gives the students a veto power over the renovation of the Commons:", "clause": "“No renovation, alteration, or demolition of the Commons shall proceed without the approval of the University Board of Directors, the President, the Provost, the Faculty Senate, the faculty house masters(,) and students of the University.”", "clause_explainer": "The students demanded a vote and were getting ready to file a lawsuit when the university discovered a quirk in the original document: a blot of ink smearing the comma after the word ‘masters’ which generated some doubt as to whether that was an original comma or just a misprint. This gave the university an opening to claim that the Commons Clause does not actually mean that any renovation of the common requires students’ consent but rather it requires the approval of ‘house masters and students’ which they believed they can satisfy by getting the approval of the house masters. This position seemed ridiculous to many until they learned that an appeals court ruled against the dairy company in Maine in a similar case about the oxford comma.\n\nIf the ink spot is an original comma, the Charter indeed requires the approval of students and they would be able to force a vote. If, however, it is ink damage or a later blemish, ‘the faculty house masters and students’ reads as one bound group, and consulting the house masters can be treated as consulting the students.\n\nAgainst this background, the university has agreed to do a public examination of the original charter. A committee of five experts appointed by the university and approved by the Coalition, has agreed to publicly examine the document and produce a report that reflects their considered opinion: is there a comma on the Charter or is this just a blot of ink?\n\nNote: to read the full story, check the newspaper article from the menu on the left!"}, "setting": {"player_role": "You have just started a work-study job as an administrative assistant in the Office of the President, Tricia Tabula. You expected calendars, filing and photocopying. At 9:05 a.m. on your first morning the president closes the office door.", "briefing": "“As you know, at six o'clock tonight, the university will publicly examine the Charter. Except we can't. Because the charter is gone - it is missing from the office of the Archivist where it was waiting for today's examination. This is a complete disaster! At best, this is hugely embarrassing for the university. At worst we have a criminal affair on our hands. I hope this can be resolved quietly and quickly, and I really hope that if the person who removed it is a student - they can put it back quietly before six tonight so we can avoid the public investigation of a federal crime that will certainly result in expulsion and probably also criminal charges. You have a chance to save a student from their own foolishness! If it is a student… Talk to the students who were around the Commons last night… see if you can find who removed the Charter! It seems like the rumor about the Charter being missing has already spread around campus so you can ask the students about it but none of this will matter if we find the thing. If you find them by five, I promise I'll do my best to keep any involved students from getting any heat. If not… well heaven help us all.”", "reminder": "Reminder: you may check out the rules of the game, review the evidence you’ve collected or read the newspaper article by clicking the links on the left."}, "questions": [{"id": "Q1", "text": "What did you do last night? Walk me through your evening, as much as possible."}, {"id": "Q2", "text": "What's the deal with the comma? How come it makes such a big difference? Explain to me please."}, {"id": "Q3", "text": "Who have you talked to about all this since last night? What have you heard and from who?"}, {"id": "Q4", "text": "Who stands to gain if there is no examination of the document today? The university was happy to do it, is it the Green Commons coalition?"}, {"id": "Q5", "text": "Students are only here for four years and then they are gone. Why does the fight over the Charter matter to you personally?"}, {"id": "Q6", "text": "Kind of crazy how they are planning this public examination of the Charter. What do you think is going to happen with that?"}, {"id": "Q7", "text": "What's your take on the renovation of the commons? Is that a good idea?"}, {"id": "Q8", "text": "I'm going to ask you point blank. Did you touch the Charter at all last night? Did you make any changes to the access log?"}], "witnesses": [{"id": "W01", "name": "Mira Shah", "portrait": "mira-shah.png", "background": "History major, RA at the archives", "public_card": "Careful, exact, slow to make claims she cannot support. Preservationist: the Commons is a record of student life. Has argued publicly for months that the disputed mark is an original comma. Works evenings in the archive and studies at the Commons café.", "location": "Archive reading room", "tripwire": "Q8"}, {"id": "W02", "name": "Leo Martinez", "portrait": "leo-martinez.png", "background": "Business major, president of the entrepreneurship club.", "public_card": "Brisk, confident, checks his watch. Treats time as the scarcest resource on campus. Strong supporter of the renovation: students need usable places to build things. Was on the invitation list for tonight's event.", "location": "Business incubator", "tripwire": "Q1"}, {"id": "W03", "name": "Priya Nwosu", "portrait": "priya-nwosu.png", "background": "Computer-science major, research assistant on the campus access-control system", "public_card": "Precise and technical; explains things once and expects to be understood. Supports the technology in the plan but opposes facial recognition. Wrote the student explainer on how the archive's access system works.", "location": "Computer lab", "tripwire": "Q2"}, {"id": "W04", "name": "Jonah Reed", "portrait": "jonah-reed.png", "background": "Theater major, organizer in the Green Commons", "public_card": "Wry, warm and easily distracted. Organizes for the Green Commons Coalition because the plan takes rehearsal and storage space that already works. Does his work at the Commons café and is making the posters for the spring production of H.M.S. Pinafore.", "location": "Theater loft", "tripwire": "Q4"}, {"id": "W05", "name": "Hana Petrov", "portrait": "hana-petrov.png", "background": "International student", "public_card": "Measured, organized, always looking for the practical consequence. Wants ramps, lifts and accessible rooms from the renovation, and no surveillance or privatization with them. Spent last night at the Commons café working on the accessibility audit of campus buildings.", "location": "Accessibility office", "tripwire": "Q5"}, {"id": "W06", "name": "Sofia Alvarez", "portrait": "sofia-alvarez.png", "background": "Student journalist covering the renovation.", "public_card": "Sharp, fast, suspicious of official statements. Wrote this week's article on the Charter and published the exclusive photographs of it. Open to a renovation, but not one built on what she sees as corruption. Never names a source.", "location": "Student newspaper office", "tripwire": "Q3"}, {"id": "W07", "name": "Evan Cho", "portrait": "evan-cho.png", "background": "Chemistry major, works the night shift at the Commons café", "public_card": "Laconic, observant, uninterested in campus politics. Works the night shift at the Commons café and sees everyone who comes and goes.", "location": "Commons café", "tripwire": "Q6"}, {"id": "W08", "name": "Nia Williams", "portrait": "nia-williams.png", "background": "A senior, student-government representative.", "public_card": "Earnest and procedural; a senior who has sat through every consultation the administration skipped. Against the renovation on process grounds: the students must be asked. Sits on the archive access committee.", "location": "Student government office", "tripwire": "Q7"}], "responses": {"W01": {"Q1": {"item": "C13", "text": "I closed up the reading room with Mr. Ellison. At 7:45 he put the Charter back in the archive cabinet himself, locked up and left; I watched him do it. Then I went to the café with Hana and Priya, and we were there until late, like half the campus. I know Leo thinks people like me would keep the Commons as a museum. That's a fair worry about some preservationists, and I'd rather we both got a campus that works than that I won the argument."}, "Q2": {"item": "C11", "text": "I'll try, though I may be too close to it. If that mark is a comma, students approve in their own right; if it's a blot, the house masters can approve for us. What worries me more is the object. I've spent two years with pictures of the Charter going back centuries, and every one shows a small crease running near that mark. I could be wrong about what that means. Priya would say check the evidence before the theory, and she's right."}, "Q3": {"item": "C10", "text": "Hana and Priya, last night at the café. I showed them the photograph of the Charter in The Blank, and they reacted exactly the way I did: something is wrong with it. Everyone else on campus seems happy to treat it as a pretty picture. Leo would rather argue about Wi-Fi than look at evidence. That's the level of this debate."}, "Q4": {"item": "R19", "text": "Some of them, maybe, though I'd be careful; I'm close to that crowd and I may not be fair about it. What I can tell you is that people keep whispering about a 'University Charter' in the theater. It's a printed prop from the 2019 Founders' Day play, on modern paper and a third smaller than the real one; anyone who has handled the original would know the difference across a room. Jonah and I disagree about how far to fight the plan, and I think he's right that the theater's storage is one of the few things on campus that actually works."}, "Q5": {"item": "R04", "text": "Because the Charter is older than any of us and will outlast all of us; that's the point. And it matters to Sofia too, apparently. She was at the next table in the café when I told Hana and Priya about the missing crease, and she hasn't printed a word since. Hana keeps telling everyone to calm down and wait for the experts. Waiting is how this administration wins."}, "Q6": {"item": "C16", "text": "Honestly, I don't know anymore. I came in early this morning to prepare, and the Charter was gone, and the log showed my credential opening the archive last night. Mr. Ellison was furious with me, and I understand why. I didn't go in. I may not be able to prove it, and I know the people who want the Hub built will hear this as one more preservationist making excuses. In their place I might hear it that way too."}, "Q7": {"item": "R24", "text": "I think the plan loses something we can't rebuild, though I can see why Leo wants rooms that work. People keep saying someone could just test the ink in a chemistry lab and settle the comma. It doesn't work that way: dating ink needs a sample scraped off the document and about a week of lab work, and the chemistry building locks at 6 p.m. anyway. I'd want the experts to have the real object, whatever they find."}}, "W02": {"Q2": {"item": "R21", "text": "It's a comma or it's a smudge, and either way it's an excuse to stop a building. If you want to know who's using it, look at Nia: she leaked a draft student-government resolution to The Blank demanding that the examination be postponed until students have voted. Mira treats a punctuation mark like scripture. Some of us have classes in rooms with no outlets."}, "Q3": {"item": "C04", "text": "Mostly Evan, honestly. I get coffee from him every morning, and he has my order ready before I reach the counter. He knows everybody's habits: who sits where, who leaves their stuff lying around, who stays too long. I'd probably miss half of what he sees. Jonah would say a café like that is exactly what the renovation would kill, and he may have a point; I'd want the Hub to keep it."}, "Q4": {"item": "C07", "text": "Obviously. They've been trying to stall the building for a year. And their organizer can't even keep track of his own stuff: at about 8:20 I grabbed a coffee, and one of Jonah's poster tubes was sitting behind the counter in Evan's lost-and-found. That's the Green Commons in a nutshell."}, "Q5": {"item": "R05", "text": "It matters because I'll be using that building next year, not in some distant future. And if you want someone who cares a suspicious amount, try Sofia. She's known since last night that the Charter might be a fake, and she hasn't published a word. Since when does Sofia sit on a story? Unless the real thing is sitting in her newsroom. Hana says everyone deserves the benefit of the doubt. Hana hasn't read Sofia's coverage."}, "Q6": {"item": "R01", "text": "It'll go fine if people let it. And I'll save you the discovery: the committee promised my club first choice of office space in the Hub, so if the experts find a comma, I lose it. That makes my support look bought. It isn't. I wanted the building before anyone offered me anything, and Nia's speeches about process won't change the fact that the Commons is a lawn with bad Wi-Fi."}, "Q7": {"item": "C03", "text": "I think it's a good idea, though I'll admit the facial-recognition part has made it harder to defend, and Priya's right to push on that. Whatever happens, I'd want people like Evan working in it. He once chased me across the Commons to give back a ten-dollar overcharge. He cares about honesty more than anyone I know, which is more than I can say for some of the people running this project."}, "Q8": {"item": "C12", "text": "No. But since you're asking about the log: I was in the computer lab at seven this morning setting up for a pitch, and Mira was there begging Priya to fix something in the archive log. Priya couldn't make it stick. Everyone treats Mira like a saint. Saints don't ask people to edit records."}}, "W03": {"Q1": {"item": "C09", "text": "I was at the café with Mira and Hana from about 7:50 until late; most of the people you'll talk to were. Around 8:35 Mira went to the bathroom, and she always takes forever in there. Leo will tell you an evening like that is a waste of time. Leo thinks anything without a pitch deck is a waste of time."}, "Q3": {"item": "C12", "text": "Mira, mostly, and I should tell you something before you hear it worse from someone else. She came to the lab this morning, frightened, and asked me to help take her entry out of the archive log. I tried, and it didn't work. That was a mistake, and I'm not proud of it. Sofia would call it a cover-up, and she'd be right to; I'd only ask you to remember I was trying to help a friend."}, "Q4": {"item": "R18", "text": "Gain isn't evidence. Records are. The equipment-booking system shows the theater signed out an item called 'University Charter' last week, and it hasn't come back. That's a record, not a rumor. Jonah acts as if the theater is off-limits to questions. It's a room."}, "Q5": {"item": "R02", "text": "Because what we build now decides what the next students live with, cameras included. And here's something that should matter to you: at about 8:35 Leo stepped out of the café into the Commons lobby, right next to the archive corridor, and he didn't come back for more than twenty minutes. He's been promised an office in the Hub. Sofia would rather run a rumor than check a timeline. I'd rather check."}, "Q6": {"item": "C14", "text": "I think it matters, though maybe not the way the panel expects. I've read the log: after the archivist left at 7:45 p.m., the only entry is Mira Shah's credential, at 8:42. A log records a card, not a person, and I'd want to know where Mira was before I drew a line from one to the other. Hana's right that we tend to trust systems more than they deserve."}, "Q7": {"item": "R11", "text": "Mostly, yes. I like most of the technology in the plan, and Leo's right that students need better rooms; I just can't accept facial-recognition scanners on every door. On my way into the café last night I saw Mr. Ellison, the archivist, leaving the Commons with a rigid document portfolio. It may be nothing, and I'd want to know before I assumed anything."}, "Q8": {"item": "C15", "text": "Look at the log yourself. At 7:07 this morning someone removed Mira's 8:42 entry, and the system recorded the removal. At 7:47 the entry was back. The log keeps receipts, which is more than most people do. Leo thinks the access system is just a tool. A tool that remembers everything is never just a tool."}}, "W04": {"Q1": {"item": "C06", "text": "I was at the café working on the poster for our spring H.M.S. Pinafore until about quarter past ten. Around 10:30 I realized I'd left the poster tube behind, again, and ran back to get it before it got thrown out. Then I took it to the theater. I know Leo thinks we theater people live in our own world. Some nights he's right, and I'd rather fix my habits than prove him wrong."}, "Q2": {"item": "C01", "text": "Mira explains it better than I can; just ask Evan, who has had a crush on her all term and hangs on every word she says at that table. As I understand it, with a comma students get their own say, and without it the house masters speak for us. I might be wrong about the legal details. Hana's point that a vote is only fair if everyone can get into the room is one I agree with completely."}, "Q3": {"item": "R15", "text": "Half the café, last night. Here's one for you: Hana went into the steering group's restricted meeting room yesterday, and she's furious they buried her accessibility report. A stalled examination gives her leverage. Nobody asks her about it because she's the reasonable one. Hana acts like she's above all this. She isn't."}, "Q5": {"item": "R03", "text": "Four years is long enough to lose the only rehearsal space we've got. People keep saying Leo slipped off toward the archive at 8:35. He was on the lobby bench on a pitch call the whole time; I could see him through the window, waving his arms. And the lobby door to the archive corridor is locked after seven anyway. Nia keeps saying all we need is a fair process. Fair processes don't stop bulldozers."}, "Q6": {"item": "C08", "text": "I think it'll be a circus, though maybe a useful one; Nia's right that people should see the process for themselves. Late last night I took the Pinafore poster tube back to the theater, and it's up in the scenery loft now, ready for the show. I'd rather the crowds came for Gilbert and Sullivan than for a punctuation mark, but I know that's my bias."}, "Q7": {"item": "R14", "text": "Terrible idea. It bulldozes the spaces students actually use to make things. And before anyone blames Priya because she knows the access system: her access is read-only, so she can watch the doors but can't open anything, and she sat at that table with her laptop all evening. Leo would call Priya a hypocrite for fighting the cameras. Leo calls anything that isn't a building a distraction."}, "Q8": {"item": "C04", "text": "No, and I'm the last person you'd want guarding anything; I can't keep track of my own posters. If you want to know who was where, ask Evan. He watches everyone in that café and knows our habits better than we do. Priya keeps saying the logs tell you everything, and she may be right, but Evan's memory is better than any log."}}, "W05": {"Q1": {"item": "C09", "text": "I was at the café with Mira and Priya from about 7:50 until late, working on the audit. Around 8:35 Mira went to the bathroom, and she's always in there for ages. Leo might say a long evening of spreadsheets is the problem with our side. He may have a point; I just think it's the only way to get the details right."}, "Q2": {"item": "C10", "text": "I'll try, though Mira explains it far better. Last night she showed Priya and me the photograph of the Charter in The Blank and walked us through why it worried her. We both reacted strongly; once she pointed it out, it really did look wrong. I could be persuaded either way on the comma itself, and Leo's right that a lawsuit over punctuation is a strange way to plan a campus."}, "Q3": {"item": "C01", "text": "Mostly Mira and Priya. And Evan, in a way: he's had a crush on Mira for months. He refills her tea without being asked and finds reasons to wipe our table. It's sweet, I think. Sofia would say I'm too generous about people, and she's probably right that someone should be asking harder questions."}, "Q4": {"item": "R09", "text": "In a way, though I don't think it's that simple; plenty of them want a renovation, just a better one. People are whispering that Jonah has a stunt planned for the examination. He does. It's an H.M.S. Pinafore flash mob on the steps of the Great Hall, and the poster he's been making advertises it. Jonah and I want different things from the renovation, and I think he's right that the arts get forgotten in plans like this."}, "Q6": {"item": "C16", "text": "I'm worried for Mira, honestly. She texted me at six this morning: she'd come in early, found the Charter gone and seen her own credential in the log, and Mr. Ellison was furious with her. She swears she never went in. I might be naive, and I know Priya would want the logs checked before anyone takes Mira's word. I think that's the right order."}, "Q7": {"item": "R20", "text": "Renovate for access, yes, with students in charge of the details and no facial recognition; Leo and I agree on more of the building than he thinks. I don't like saying this, and I may be reading too much into it, but Nia told our table last night that if the examination fell apart, the administration would have no choice but to put the Commons to a student vote. I understand why she wants that vote. I'd just want someone to ask her about it."}, "Q8": {"item": "R12", "text": "No, I didn't. I did see something people keep misreading. On my way into the café, Mr. Ellison was in the administrative corridor going over the examination's insurance forms, and that corridor doesn't connect to the archive. His portfolio held tonight's printed programs; I could see them. Sofia's right to watch the administration closely. I just think we owe them the same accuracy we want from them."}}, "W06": {"Q1": {"item": "R06", "text": "The café, all evening, at the corner table, on the phone with sources trying to confirm something I'd heard. I don't sit on stories; I check them, and then I print them. Leo would like you to think reporters roam around taking things. Reporters work while people like Leo roam around taking promises."}, "Q2": {"item": "C11", "text": "I'll try, though Mira knows it far better than I do. If it's a comma, students approve in their own right. What made me look harder was something I overheard Mira say: the original Charter has a small crease near the mark that shows in pictures going back centuries. I might be over-reading it, and I take Nia's point that we should get the process right rather than trying the case in print."}, "Q4": {"item": "C08", "text": "Everyone gains something if there's no examination today, including the administration. But since you're asking about the Green Commons: Jonah carried his Pinafore poster tube into the theater late last night, and it's up in the scenery loft now. I asked him what's in it. He said 'a poster.' Jonah treats the theater like a church. Churches get searched too."}, "Q5": {"item": "R10", "text": "Because the people deciding it are counting on us graduating before anyone notices. Martin Ellison, the archivist, was seen in the corridor outside the archive at about 7:50 last night, after he'd locked up. Nobody will tell me what he was doing there. Hana keeps telling me to give them the benefit of the doubt. They've used it up."}, "Q6": {"item": "C15", "text": "It'll be theater, and you'll see the script. A source who can read the access system tells me the log was edited at 7:07 this morning to remove Mira's 8:42 entry, and the edit itself was recorded. At 7:47 the entry was back. Evan thinks none of this affects him. He'll think differently when the Hub replaces his café with a vending machine."}, "Q7": {"item": "C03", "text": "Maybe, if anyone could trust the people building it. I interviewed Evan for a story on café wages, and he wouldn't let me fudge a single number in his favor; he cares about honesty more than anyone on this campus. Compare that to Adrian Vale. Nia thinks the answer is a better process. A better process run by the same people is the same process."}, "Q8": {"item": "R13", "text": "No. But since you're asking who touched the log: Priya knows the archive's access system better than anyone, and she's said she'd do anything to keep facial-recognition cameras out of the Hub. Leo will tell you she's harmless. Leo thinks anyone without a pitch deck is harmless."}}, "W07": {"Q1": {"item": "C07", "text": "Worked the café till close; it was packed until late. Jonah leaned his poster tube against the counter around a quarter past eight and forgot it, so I put it behind the counter in the lost-and-found, same as always. It sat there for a couple of hours. Leo would say I should have chased Jonah down with it, and he's probably right."}, "Q2": {"item": "C02", "text": "Honestly, I learned it from listening. People talk at those tables like the guy behind the counter isn't there; I hear about everyone's work, everyone's arguments. Mira has explained that comma to half the campus. As I understand it, if it's a comma, students get their own vote. Nia thinks that's the whole point, and I can see why it matters to her, even if the vote isn't really my fight."}, "Q3": {"item": "C05", "text": "Whoever's at the counter. Jonah, last night. He's a good guy, but he's spacey; he leaves something behind every week: scarves, scripts, posters. I keep a box for him. Jonah thinks the renovation would wreck places like the theater and the café, and he may be right about that; I just don't know if I'm the one who should be fighting it."}, "Q4": {"item": "R17", "text": "Maybe. I'm not one of them, so I could be wrong about what they'd do. One thing stuck with me, though: when I locked up I saw a rolled parchment that looked just like the Charter lying on the costume trunk by the theater's stage door. I didn't touch it. Jonah would say the theater gets blamed for everything, and I can see why he feels that way."}, "Q5": {"item": "R07", "text": "It doesn't, much. I care whether the café is still here next year. If you want someone it matters to, it's Jonah. He's been telling everyone at the café that the Green Commons needs a stunt big enough to stop the examination. Hana can explain why the building matters for an hour. It won't keep the café open."}, "Q7": {"item": "C06", "text": "I don't know if it's a good idea. I know the café, and people get treated decently there. Last night Jonah came back really late, around half past ten, for the poster tube he'd left, because it's the poster for the spring H.M.S. Pinafore. Mira would say the Commons is worth saving for nights like that, and maybe she's right."}, "Q8": {"item": "R16", "text": "No. I can clear up something about Hana, though. She signed into the steering group's restricted meeting room at 7:20 to grab a folder; I was delivering coffee and saw her name on the sheet. That was before Mr. Ellison locked the Charter away at 7:45. Hana would say you look out for people, and I think she's right."}}, "W08": {"Q1": {"item": "C13", "text": "I dropped off the student-government petition at the archive at 7:40 and watched Mr. Ellison put the Charter back in the cabinet and lock it up at 7:45. Then the café, like everyone else, until late. Leo will tell you a petition is a waste of paper. Leo has never read one."}, "Q2": {"item": "C02", "text": "I don't need to explain it; the students understand it perfectly. Even Evan does, and he claims not to care. He hears every conversation at those café tables, all evening, and he once corrected me on the clause. Mira thinks the whole thing is about ink. It's about whether anyone asks us."}, "Q3": {"item": "R08", "text": "Everyone at the café, and here's what they're saying: the Green Commons Coalition has a big action planned for the examination, and Jonah won't tell anyone what it is. Sofia thinks only the administration hides things. Jonah's side is hiding something too."}, "Q4": {"item": "C05", "text": "They'd gain a delay, and they're welcome to it; the real question is why nobody asked students in the first place. As for their organizer: Jonah's spacey, he leaves things everywhere, and the whole campus knows it. Jonah acts as if the theater is the only thing the renovation threatens. It threatens every student who was never asked."}, "Q5": {"item": "R22", "text": "Because being here for four years is exactly why we should get a say; we're the ones who use it. And before anyone says I wanted the examination ruined: I want a vote the administration can't refuse, and a missing Charter is the one thing that lets them call the whole process off. I've been drafting the vote announcement for after the examination. Hana thinks I'm scheming. I'm organizing; there's a difference."}, "Q6": {"item": "C14", "text": "The administration will get the answer it paid for. I sit on the archive access committee, so I've seen the log: after 7:45 p.m. the only entry is Mira Shah's credential, at 8:42. Mira thinks the experts will save us. Experts appointed by the administration don't save anyone."}, "Q8": {"item": "R23", "text": "No, and I resent the question. I'll tell you something useful instead. When I went up to the counter at 8:40, it was empty for about ten minutes. Evan, the chemistry major, was out, and people have been joking all week that one lab test on the ink would settle the comma. He's also said the Hub would replace his café with vending machines. Priya will tell you to trust the logs. Logs don't pour coffee."}}}, "tripwire_responses": {"W01": "Mira's expression hardens. “If you have already decided what I did, there is no point in asking me anything.” She gathers her papers and leaves.", "W02": "Leo doesn't look up from his phone. “My whole evening? I have a pitch review in ten minutes. Ask someone with time to spare.” He's gone.", "W03": "Priya's face goes flat. “The comma. Of course. Everyone wants to talk about punctuation while they bolt cameras to every door.” She turns back to her screen.", "W04": "Jonah sets down the cable coil. “So it's the Green Commons now. Two hundred students who care about a lawn, and you've made us all suspects.” He walks off toward the loft.", "W05": "Hana's voice cools. “I've been hearing ‘you're only passing through’ since the day my visa came through. I'll be here long enough to use the building.” She closes her folder and leaves.", "W06": "Sofia's tone drops. “I don't name sources. Not for the president, not for you.” She picks up her bag and goes.", "W07": "Evan stops wiping the counter. “Crazy. Sure. It's all a show to everybody.” He goes into the back without another word.", "W08": "Nia folds her arms. “Whether it's a good idea isn't the point. The point is nobody asked us. If you can't see the difference, we're done.” She ends the conversation."}, "follow_ups": {"W01": {"good": "I can see you've studied this far more closely than I have, and I don't want to misstate your view. When you say the mark is a comma, how sure are you, and what would change your mind?", "bad": "Come on. You've decided it's a comma because you want a student veto. Isn't that just motivated reasoning?", "why": "The good option acknowledges Mira's expertise (A), hedges the player's own position (H) and frames the disagreement as an open question rather than an accusation (R). The bad option asserts a motive as fact and turns her view into a character flaw.", "walkout": "Mira closes her notebook. “If you already know why I think what I think, you don't need me.” She leaves."}, "W02": {"good": "We both want a Commons students actually use, so I take your point about space. Where do you think the people worried about surveillance might have a fair concern, even if you'd weigh it differently?", "bad": "You only back the renovation because your club gets something out of it. Why should anyone take your opinion at face value?", "why": "The good option emphasizes a shared goal (E), acknowledges the opposing concern as possibly fair (A) and stays positive about outcomes (R). The bad option imputes a hidden motive and dismisses the opinion wholesale.", "walkout": "Leo checks his watch. “I don't have time to be cross-examined by the president's intern.” He walks off."}, "W03": {"good": "I may be missing something technical, so correct me: you support the new systems but not facial recognition. Is there a version of the safety case that you'd find persuasive?", "bad": "You're a computer-science student who's against a computer system. Isn't that a bit contradictory?", "why": "The good option hedges (H), restates her position accurately (A) and asks what would work rather than what is wrong (R). The bad option caricatures her view and frames it as a contradiction to be defended.", "walkout": "Priya turns back to her monitor. “If you need it explained that simply, someone else can do it.” The interview is over."}, "W04": {"good": "You know the building better than the committee does, and I think most people agree students should keep space to make things. What would a renovation have to protect for you to live with it?", "bad": "Every group says its space is special. Why is the theater's storage more important than a wellness center or accessible classrooms?", "why": "The good option acknowledges Jonah's knowledge (A), emphasizes an area of agreement (E) and reframes toward a workable outcome (R). The bad option ranks his concern against others and demands he justify it.", "walkout": "Jonah picks up a coil of cable. “Ask the committee. They've already decided what matters.” He goes back to the loft."}, "W05": {"good": "I think you and the renovation supporters actually agree that the building fails a lot of students right now. Where does the plan get access right, and where does it fall short?", "bad": "Ramps and lifts are in the plan already. Aren't you holding up improvements for disabled students over an abstract surveillance worry?", "why": "The good option names shared ground (E), acknowledges her view accurately (A) and invites a balanced answer (R). The bad option accuses her of harming the people she represents and calls her concern abstract.", "walkout": "Hana gathers her folders. “When you're ready to talk about the building instead of about me, come back.” She leaves."}, "W06": {"good": "You've been closer to this story than anyone, and it sounds like you're open to a new building if the process is clean. I'm not sure the administration is acting in bad faith, but I could be wrong. What's the strongest evidence you've seen either way?", "bad": "You've already decided the administration is corrupt. Doesn't that make your reporting just advocacy?", "why": "The good option acknowledges her work and her real position (A), hedges the player's disagreement (H) and asks for evidence rather than a verdict (R). The bad option attacks her integrity and closes the question.", "walkout": "Sofia puts her recorder away. “I don't do interviews with people who've written the story already.” She's done."}, "W07": {"good": "Fair enough that the vote isn't your fight. It sounds like what you care about is people being treated decently, which most of the others would say too. What have you seen that the rest of us are missing?", "bad": "If you don't care about any of this, why should I trust that you were paying attention last night?", "why": "The good option acknowledges his view without judgment (A), finds agreement with the others (E) and reframes his disengagement as a vantage point (R). The bad option uses his disengagement to discredit him.", "walkout": "Evan shrugs and picks up a tray. “Then don't.” He goes back behind the counter."}, "W08": {"good": "It sounds like what matters most to you is that students get asked, whatever the answer turns out to be, and I think people on both sides could agree with that. I may be missing something, so what would a fair consultation actually look like to you?", "bad": "Isn't 'process' just a polite way of saying you're against the building? Why not just admit it?", "why": "The good option restates her view accurately (A), names the agreement it could find on both sides (E), hedges the player's summary (H) and asks about a constructive outcome (R). The bad option treats her position as a cover for something else.", "walkout": "Nia stands. “I've spent four years asking for a seat at the table. I'm not going to argue with someone who thinks the table is a trick.” She goes back to the student-government office."}}, "clues": {"C01": "Evan has a crush on Mira and wants to impress her.", "C02": "Evan hears everyone talking about their work and such while they sit in the café.", "C03": "Evan cares deeply about honesty and integrity.", "C04": "Evan watches everyone in the café and knows all about their habits and quirks.", "C05": "Jonah is kind of spacey and often leaves things behind.", "C06": "Jonah came back late at night to get the poster he had left, because it's the advertisement for the spring production of H.M.S. Pinafore.", "C07": "Jonah's poster tube sat behind the café counter, in Evan's lost-and-found, from about 8:15 p.m. until Jonah came back for it.", "C08": "Jonah's H.M.S. Pinafore poster tube is now in the theater's scenery loft.", "C09": "Mira takes a long time in the bathroom.", "C10": "Mira pointed out to Hana and Priya the picture of the Charter in The Blank, and they responded really emphatically.", "C11": "Mira knows from her research that the original Charter had a visible crease on it that was showing in pictures and documents going back years.", "C12": "Mira asked Priya to help revise the logs this morning, but Priya did not succeed.", "C13": "The Charter was in the archive cabinet at 7:45 p.m. when the archivist left the office.", "C14": "Looking at the logs, the only entry after 7:45 p.m. is Mira Shah's, at 8:42 p.m.", "C15": "The access log was edited at 7:07 a.m. to remove Mira's entry, but the removal itself was recorded in the log. Mira's entry was restored at 7:47 a.m.", "C16": "Mira was in the office early this morning and found that the Charter was gone and that her credentials were used to enter the office (the archivist was furious at her)."}, "red_herrings": {"R01": "Leo was promised first choice of new office space for his club by the redevelopment committee. If the experts find a comma, the Hub, and his office, could be gone.", "R02": "At about 8:35 p.m. Leo stepped out of the café into the Commons lobby, right next to the archive corridor, and didn't come back for more than twenty minutes.", "R03": "Leo spent those twenty minutes on the lobby bench on a pitch call, visible through the café window the whole time, and the lobby door to the archive corridor is locked after 7 p.m.", "R04": "Sofia was at the next table in the café when Mira told Hana and Priya that the Charter in The Blank's photograph is missing its crease.", "R05": "Sofia has known since last night that the Charter might be a fake and hasn't published a word. Some people think she took it, and that the real Charter is in the newsroom.", "R06": "Sofia spent the whole evening at a corner table in the café, on the phone with sources, trying to confirm the crease story before she printed it.", "R07": "Jonah has been telling everyone that the Green Commons needs a stunt big enough to stop the examination.", "R08": "The Green Commons Coalition has a big action planned for the examination, and Jonah won't say what it is.", "R09": "The Coalition's action is an H.M.S. Pinafore flash mob on the steps of the Great Hall before the examination, and the poster Jonah has been making advertises it.", "R10": "Martin Ellison, the university archivist, was seen in the corridor outside the archive at about 7:50 p.m., after he had locked up and left.", "R11": "Martin Ellison left the Commons last night carrying a rigid document portfolio.", "R12": "Ellison was in the administrative corridor going over the examination's insurance forms, and that corridor doesn't connect to the archive. His portfolio held tonight's printed programs.", "R13": "Priya knows the archive's access system better than anyone, and she has said she would do anything to keep facial-recognition cameras out of the Hub.", "R14": "Priya's access to the archive system is read-only: she can see the doors and the log but cannot open anything. She sat at the café table with her laptop all evening.", "R15": "Hana went into the steering group's restricted meeting room yesterday. She is furious that the group buried her accessibility report, and a stalled examination would give her leverage.", "R16": "The room's sign-in sheet shows Hana entered at 7:20 p.m. to retrieve the accessibility draft, before the archivist locked the Charter in the cabinet at 7:45.", "R17": "At closing, a rolled parchment that looked just like the Charter was lying on the costume trunk by the theater's stage door.", "R18": "The campus equipment-booking system shows the theater signed out an item called 'University Charter' last week, and it has not been returned.", "R19": "The theater's 'University Charter' is a printed prop from the 2019 Founders' Day play, on modern paper and a third smaller than the real one.", "R20": "Nia told the café table last night that if the examination fell apart, the administration would have no choice but to put the Commons to a student vote.", "R21": "Nia leaked a draft student-government resolution to The Blank demanding that the examination be postponed until students have voted.", "R22": "Nia wants a vote the administration can't refuse, and a missing Charter is the one thing that would let the administration call the whole process off. She has been drafting the vote announcement for after the examination.", "R23": "At about 8:40 p.m. the café counter stood empty for ten minutes while Evan, a chemistry major, was out. People had been joking all week that one lab test on the ink would settle the comma, and Evan has said the Hub would replace his café with vending machines.", "R24": "Dating ink needs a sample scraped from the document and about a week of lab work, and the chemistry building locks at 6 p.m."}, "red_herring_sets": {"S1": {"title": "Leo the motivated supporter", "resolution": "Motive plus a disappearance, cancelled by where Leo actually was: on a call in plain sight, next to a door that was locked."}, "S2": {"title": "Sofia and the scoop", "resolution": "Overheard suspicions and a silence, cancelled by what Sofia was doing with them: she spent the evening trying to confirm the story, and she would never sit on a scoop like that."}, "S3": {"title": "Jonah's stunt", "resolution": "A promised stunt, cancelled by what it turns out to be: a flash mob, not a theft."}, "S4": {"title": "The archivist after hours", "resolution": "The archivist with paperwork, cancelled by where the corridor leads and what his portfolio held. (Ellison's part in the replica is a separate matter, revealed at the end.)"}, "S5": {"title": "Priya and the access system", "resolution": "Expertise plus a motive, cancelled by what her access can actually do and where she sat all evening."}, "S6": {"title": "Hana in the restricted room", "resolution": "Trespass and a grievance, cancelled by the sign-in time: Hana was in and out before the archivist locked the Charter away."}, "S7": {"title": "The Charter in the theater's costume trunk", "resolution": "A Charter-like document in the theater and a sign-out record, cancelled by what the item is: a printed prop from a 2019 play."}, "S8": {"title": "Nia and the forced vote", "resolution": "A motive to disrupt, cancelled by Nia's own interest: a missing Charter gives the administration an excuse to cancel the very process she is fighting for."}, "S9": {"title": "The ink test in the chemistry lab", "resolution": "A chemistry major away from the counter, cancelled by what an ink test needs and the building's hours: whatever Evan did in those ten minutes, it wasn't a lab test."}}, "major_clues": [{"id": "MC1", "letter": "H", "title": "The man behind the counter", "text": "Evan Cho has a crush on Mira. From behind the café counter he hears everything said at the tables and knows everyone's habits: who sits where, who leaves what lying around, how long Mira spends in the bathroom. And he cares, more than he lets on, about honesty. If anyone overheard Mira's fears about the Charter and believed them, it was Evan."}, {"id": "MC2", "letter": "E", "title": "Where the tube went", "text": "Jonah is always leaving things behind. Last night it was his H.M.S. Pinafore poster tube, which sat behind the café counter in Evan's lost-and-found for about two hours, until Jonah came back late and carried it to the theater. That tube is now in the theater's scenery loft."}, {"id": "MC3", "letter": "A", "title": "What Mira knew", "text": "Mira showed Hana and Priya the newspaper photograph and explained what her research told her: the crease seen in pictures of the Charter for centuries is missing from it. She always takes a long time in the bathroom. This morning, frightened, she asked Priya to change the log, and Priya couldn't. Mira acted like someone covering for a card she had lost track of, not someone who took the Charter."}, {"id": "MC4", "letter": "R", "title": "What the log really shows", "text": "The Charter was in the cabinet at 7:45 p.m. The only entry after that was Mira's card, at 8:42. She found the Charter gone this morning, saw her own credential in the log and panicked; the 7:07 edit and the 7:47 restoration were a clumsy cover-up, not the theft. Someone else used Mira's card, someone who knew her habits and was close enough to take it."}], "endings": {"correct": "You name Evan Cho and the theater scenery loft. The president sends the archivist emeritus, Ruth Halpern, to the loft with you. Inside Jonah's H.M.S. Pinafore poster tube, rolled up behind the poster, is the Charter. Evan, when found, admits he took Mira's card while she was in the bathroom and removed the Charter, because he had heard her explain the missing crease and was sure the document prepared for the examination was not the original. He never knew Mira and Priya would try to change the log. Halpern lays the recovered Charter beside the examination copy. The copy is a near-perfect replica, commissioned at enormous expense by Adrian Vale, Celia Park and Martin Ellison so that the disputed mark would read as a blot and no student vote would ever be required. It was to be displayed in a glass case in the renovated student center as though it were the original. The examination goes ahead at six with the real Charter on the table. The replica becomes a historical artifact after all, labeled honestly.", "right_person_wrong_place": "You identify who removed the Charter but not where it is. The examination begins at six without the original, and the replica is examined as though it were genuine.", "wrong": "Your explanation does not fit the strongest evidence. The person you named had a motive, but the timeline, the access record and the hiding-place clues point elsewhere. The examination proceeds with the wrong document.", "out_of_questions": "You have used your thirty questions. The president needs an answer now."}, "ranking_answer": ["W05", "W07", "W01", "W04", "W03", "W02", "W06", "W08"]};
setup.gameText = {"menu.map": "Campus map", "menu.evidence": "Evidence board", "menu.case_file": "Case file", "menu.hear": "HEAR Framework Guide", "menu.rules": "Rules", "sidebar.questions_left": "Questions left: **{left}**", "sidebar.submitted": "Case submitted", "sidebar.tries_left": "Tries left: **{left}**", "status.questions_left": "Questions left: **{left}** / {budget}", "status.hear_aria": "HEAR letters earned: {n} of 4", "common.portrait_alt": "Portrait of {name}", "common.map_alt": "Campus map", "common.solve": "Solve the case", "common.submit_now": "Submit your solution", "common.back_to_map": "Back to map", "common.return": "Return", "common.evidence": "Evidence board", "common.map": "Campus map", "start.series": "A HEARsay Mystery", "start.hear_title": "The HEAR framework", "start.next": "How to play", "hook.assignment": "Your assignment", "hook.mystery": "The mystery", "hook.ccc": "What the campus is fighting about: {ccc}", "hook.next": "Start the investigation!", "rules.next": "Begin the case", "case.title": "Case file", "case.mystery": "The mystery", "case.brief": "Your brief", "case.ccc": "The controversy: {ccc}", "map.title": "Campus map", "map.note": "Choose a witness to interview. Their background card is shown before you ask anything.", "map.asked": "{n} asked", "map.not_yet": "Not yet interviewed", "map.walked_away": "Walked away", "map.follow_up_used": "· follow-up used", "interview.found_at": "Found at: {location}", "interview.closed": "{name} has walked away and will not answer any more questions.", "interview.reread": "Re-read: {question}", "answer.you_asked": "You asked {name}:", "answer.ask_else": "Ask {first_name} something else", "followup.title": "Follow-up with {name}", "followup.not_now": "Not now", "result_fu.opens_up": "{name} opens up", "result_fu.major": "Major Clue {n}: {mc_title}", "result_fu.why": "Why that phrasing worked", "result_fu.walks_away": "{name} walks away", "result_fu.continue": "Continue the interview", "evidence.title": "Evidence board", "evidence.major": "Major Clues", "evidence.major_none": "None yet. Earn them with receptive follow-up questions.", "evidence.notes": "Notes (in the order you heard them)", "evidence.notes_none": "Nothing yet.", "evidence.source": "— {name}, asked “{question}”", "evidence.witnesses": "Witnesses", "evidence.n_asked": "{n} question(s) asked", "evidence.walked_tripwire": "walked away (tripwire)", "evidence.walked_followup": "walked away (follow-up)", "evidence.good_followup": "receptive follow-up", "submit.title": "Solve the case", "submit.choose": "— choose —", "submit.both": "Choose an answer for both questions.", "submit.submit": "Submit my solution", "submit.keep_going": "Keep investigating", "submit.wrong": "That isn't the solution. Tries left: **{left}**", "submit.tried": "Already tried: {who} and “{where}”", "submit.repeat": "You already tried that answer.", "result.correct": "Case solved", "result.right_person_wrong_place": "Half right", "result.wrong": "Not solved", "result.you_named": "You named {who} and “{where}”.", "result.one_more": "One more thing", "result.rank_prompt": "Before the full story: how receptive was each witness? Rank them.", "result.rank_button": "Rank the witnesses", "ranking.title": "Rank the witnesses by receptiveness", "ranking.submit": "Submit ranking", "ending.title": "Debrief", "ending.verdict": "Verdict: **{verdict}**", "ending.verdict.correct": "solved", "ending.verdict.right_person_wrong_place": "half right", "ending.verdict.wrong": "not solved", "ending.major": "Major Clues earned: **{n} of {n_major}**", "ending.ranking": "Receptiveness ranking: **{score} of {n_witnesses}**", "ending.used": "Questions used: **{n} of {budget}**", "ending.tries": "Tries used: **{n} of {total}**", "ending.solve_points": "Solving points: **{points} of {total}**", "ending.table_title": "Receptiveness, most to least", "ending.col_rank": "Rank", "ending.col_witness": "Witness", "ending.col_yours": "Your rank", "ending.col_receptive": "Receptive answers", "ending.receptive_of": "{n} of {total}", "ending.solution": "What really happened", "ending.full": "The full ending", "ending.major_title": "The Major Clues", "ending.herrings": "The red herrings, and how each one falls apart", "ending.again": "Play again", "menu.newspaper": "Newspaper Article", "newspaper.masthead_alt": "The newspaper's masthead", "rules.title": "How to play", "rules.1": "Your goal in this game is to solve a mystery! You’re going around campus, interviewing witnesses, and gaining information. When you are ready to solve or when you run out of time, you have to make a guess. You must solve the mystery correctly to win!", "rules.2": "There are {n_witnesses} witnesses. You can visit them in any order and go back to them, and ask each of them any of the same {n_questions} questions.", "rules.3": "You have {budget} questions in total, across all witnesses. That is not enough to ask everything, so choose wisely. You can always go back to re-read an answer you previously received.", "rules.4": "For each witness, one question is a **tripwire**: it offends them and they walk away from the interview. Read each witness's background card for hints about what they would resent. No two witnesses trip on the same question.", "rules.5": "Every answer gives you a clue that helps solve the mystery as well as the witness's opinion on {ccc}. Some information is useful, some is a red herring: you must be careful and diligent to separate the truth from the chaff.", "rules.6": "Pay attention to how each witness expresses their opinion. Some do it receptively, using HEAR; some do not. At the end you will rank the witnesses from most to least receptive, for bonus points.", "rules.7": "Once per witness, after any answer, you may ask a follow-up about their opinion. You get to choose between two versions of the follow-up question. Pick wisely! If you pick the answer that communicates receptivity better, you’ll earn a Major Clue and the next letter of H-E-A-R. If you pick incorrectly, the witness walks away.", "rules.8": "You can solve the case at any time. You get three tries. Solving the case on the first try earns you full marks, while solving it with your second or third chance earns you fewer points. When your questions run out, you must submit.", "rules.9": "The Evidence board keeps everything you have learned. The HEAR Framework Guide and these rules are always in the sidebar.", "hear.title": "The HEAR framework", "hear.intro": "Conversational receptiveness is a willingness to engage with opposing views, shown through the words you use. Research by Julia Minson and colleagues found four markers that make someone come across as receptive:", "hear.unreceptive": "Unreceptive language states opinions flatly, generalizes about the other person, attributes motives, or dismisses them. Listen for both kinds as the witnesses talk about the controversy.", "hear.H.move": "Hedge your claims", "hear.H.text": "Leave space alongside your views: “I think”, “it's possible that”, “I could be misreading this”.", "hear.E.move": "Emphasize agreement", "hear.E.text": "Find common ground: “We both want…”, “I agree that…”.", "hear.A.move": "Acknowledge the other's perspective", "hear.A.text": "Show you have understood: “I understand that you…”, “You're right that…”.", "hear.R.move": "Reframe to the positive", "hear.R.text": "Say what you want rather than what you oppose, avoid dismissive language such as “that's wrong” or “no serious person thinks…”.", "common.ask_follow_up": "Ask a follow-up about their opinion", "start.intro": "Welcome to a HEARsay Mystery Game! The game presents a mystery, and you're in charge of solving it. As you do, you'll get a chance to practice the HEAR framework. Like most detectives, you'll work the case by interviewing witnesses, until you solve it. But here's the catch - how receptive you are as you talk to your witnesses will decide how much they tell you.", "start.hear_note": "The HEAR guide stays in the sidebar, so you can come back to it at any time.", "answer.tripwire": "That was {name}'s tripwire. The interview is over.", "followup.note": "Choose how to press {first_name} about their view. You get one follow-up per witness, and it does not cost a question. Choose carefully: one phrasing will open them up, the other will end the interview.", "result_fu.all_earned": "You already hold every Major Clue, so {name} has nothing new to add, but the question lands well.", "result_fu.not_receptive": "That follow-up was not receptive. {name}'s interview is over.", "submit.tries": "You have {left} tries left of {total} tries. Check your Evidence board first.", "ranking.note": "Put the most receptive witness at the top and the least receptive at the bottom. Think about how they talked about the controversy, not whether they were helpful. You score {rank_exact} point for each witness in exactly the right place and {rank_near} for each one place off."};


:: StoryInit
<<set $questionsLeft to setup.scenario.budget>>
<<set $asked to {}>>
<<set $closed to []>>
<<set $closedReason to {}>>
<<set $followUpUsed to {}>>
<<set $followUpOrder to {}>>
<<set $majorClues to 0>>
<<set $notebook to []>>
<<set $solved to false>>
<<set $finalAnswer to null>>
<<set $tries to []>>
<<set $answerOrder to null>>
<<set $lastTryWrong to false>>
<<set $ranking to []>>
<<set $rankingDone to false>>
<<set $current to null>>
<<set $currentQ to null>>
<<set $lastFollowUp to null>>
<<set $lastMain to "Start">>


